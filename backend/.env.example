# Supabase Edge Function secrets for checkout and administration.
# Comma-separated list of verified admin account email addresses.
ADMIN_EMAILS=

# Optional. Must match the gateway secret when origin protection is enabled.
API_GATEWAY_SHARED_SECRET=

# Optional Google Sheets mirror. Share the spreadsheet with the service account as Editor.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Checkout
# Copy the service account JSON onto one line and preserve escaped newlines in the private key.
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# Site origin for guest checkout activation emails
MYTILESTRIAL_SITE_URL=https://mytilestrial.com
