# Docker gateway and frontend build settings.
SUPABASE_API_HOST=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_SUPPORT_WHATSAPP=
FRONTEND_REPLICAS=2
GATEWAY_PORT=8080
GATEWAY_PUBLIC_SCHEME=http
GATEWAY_TRUSTED_PROXY_CIDR=127.0.0.1/32

# Optional origin protection. Use the same random hexadecimal value in Supabase.
API_GATEWAY_SHARED_SECRET=
