# Copy to .env.local and fill in. Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the API edge function (defaults to {SUPABASE_URL}/functions/v1/api).
# Use /api when running behind the NGINX gateway.
NEXT_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api

# Public URL of this site (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WhatsApp support number in international format, digits only
NEXT_PUBLIC_SUPPORT_WHATSAPP=
